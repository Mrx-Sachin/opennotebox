# Copy this file to .env and fill in at least JWT_SECRET before running
# `docker compose up`. Every variable below has a working default baked
# into docker-compose.yml except JWT_SECRET, which compose deliberately
# refuses to start without (see the comment on that variable).

COMPOSE_PROJECT_NAME=open-notebox

# --- Postgres -----------------------------------------------------------
# Credentials for the bundled `postgres` container (docker-compose.yml).
# Postgres is only reachable from other containers / localhost, so the
# defaults below are fine for a single-user self-hosted install; change
# them if you're uncomfortable with a default password even on loopback.
POSTGRES_USER=opennotebox
POSTGRES_PASSWORD=opennotebox
POSTGRES_DB=open_notebox
POSTGRES_PORT=5432

# --- LLM backend: Ollama --------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works here, but this is
# tuned for Ollama running natively on your host machine (not in Docker).
# host.docker.internal resolves to the host from inside a container -
# docker-compose.yml maps it explicitly so this also works on Linux, where
# host.docker.internal isn't available by default.
#
# If Ollama runs somewhere else (a different machine, a container on the
# same compose network, etc.), point this at that host instead, e.g.
# http://ollama:11434/v1 or http://192.168.1.50:11434/v1.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Model tags below are examples - pull whatever you actually have locally
# (`ollama pull <model>`) and put its tag here. OLLAMA_MODEL_SUMMARY is used
# for page/section/podcast summarization; OLLAMA_MODEL_CHAT for the chat panel.
OLLAMA_MODEL_SUMMARY=gemma3:27b
OLLAMA_MODEL_CHAT=qwen2.5:32b

# --- LLM backend: OmniRoute (default) -------------------------------------
# Local OmniRoute route via model-router bridge.
VLLM_BASE_URL=http://host.docker.internal:8766/v1
VLLM_MODEL=antigravity/gemini-3.8-flash-tiered
VLLM_API_KEY=not-needed
# The bridge binds publicly for Docker access but rejects clients outside
# loopback and Docker's usual private 172.16/12 bridge range. Adjust the CIDRs
# only if your Docker network uses another range.
BRIDGE_HOST=0.0.0.0
BRIDGE_ALLOWED_CIDRS=127.0.0.0/8,172.16.0.0/12

# --- LLM request admission -----------------------------------------------
# Shared through Redis so the API and Celery workers use one deployment-wide
# bound. These are admission limits, not provider-capacity guarantees.
LLM_MAX_CONCURRENCY=24
LLM_FOREGROUND_MAX_CONCURRENCY=20
LLM_BACKGROUND_MAX_CONCURRENCY=4
LLM_FOREGROUND_WAIT_SECONDS=5
LLM_BACKGROUND_WAIT_SECONDS=120
LLM_ADMISSION_LEASE_SECONDS=90
LLM_ADMISSION_REDIS_URL=redis://redis:6379/2
LLM_ADMISSION_KEY_PREFIX=deepread:llm-admission

# --- Auth -----------------------------------------------------------------
# Required. Generate a real secret - the app will refuse to start with a
# placeholder value (empty, "CHANGE_ME", "secret", or anything under 16
# chars). Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# --- Storage ----------------------------------------------------------
UPLOAD_MAX_SIZE_MB=200
# URL uploads (/api/documents/upload-url) refuse links that resolve to
# private/loopback addresses by default, so the API can't be used to reach
# internal services (Redis, Postgres, cloud metadata). Set true only if you
# deliberately upload from a file server on your own network. Metadata and
# other reserved ranges stay blocked either way.
DOWNLOAD_ALLOW_PRIVATE_HOSTS=false
# On-disk cap for cached TTS/podcast audio (data/tts-cache). A background
# job evicts the least-recently-used files hourly once this is exceeded.
TTS_CACHE_MAX_GIB=2
# Max age in days for cached TTS audio before automatic TTL eviction.
TTS_CACHE_MAX_AGE_DAYS=7

# --- Ports (host side) --------------------------------------------------
# Host port for the HTTPS entry point. This is the only port a browser needs;
# API_PORT and FRONTEND_PORT below are bound to 127.0.0.1 for debugging and
# are not usable directly, because the frontend addresses the API relative to
# whatever origin served the page.
HTTPS_PORT=443
API_PORT=8000
FRONTEND_PORT=3000

# --- CORS -----------------------------------------------------------------
# JSON array of origins allowed to call the API. Add your frontend's origin
# here if you're not using the default port/host.
CORS_ORIGINS=["http://localhost:3000"]
# Additionally allow any origin on a private network (LAN, mDNS .local names,
# Tailscale), so opening the app from a phone or second laptop at
# http://<this-machine-ip>:3003 works without listing every device's address
# here. Set to false on a publicly reachable instance, where CORS_ORIGINS
# should be the only thing honoured.
CORS_ALLOW_PRIVATE_NETWORKS=true

# --- TTS (optional) --------------------------------------------------------
# Concurrent synthesis slots for the tts service. Leave unset to let it
# pick a sensible default (higher when a GPU is actually active - see the
# GPU section in README.md). Only set this if you need to tune it for your
# hardware.
TTS_MAX_CONCURRENCY=

# Closed by default: the FIRST account registered on an instance becomes its
# admin, so open registration on a reachable URL hands ownership to whoever
# visits first. For a fresh install set this to true, create your account,
# then flip it back to false (or set it true in .env only while bootstrapping).
ALLOW_REGISTRATION=false
